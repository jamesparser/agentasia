# Use an IP-based URL temporarily, e.g. http://203.0.113.10:8787.
# Replace with https://app.yourdomain.tld once a domain and TLS are configured.
PORT=8787
APP_ORIGIN=http://YOUR_VPS_IP
MODEL_GATEWAY_ENABLED=false
SCHEDULER_ENABLED=false

