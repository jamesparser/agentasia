# AgentAsia API — Environment Configuration
# Copy to .env and fill in the keys you want to enable.
# NEVER commit .env to git.

PORT=8787
# Bind localhost: this process is meant to sit behind a tunnel/proxy. 0.0.0.0 on
# a machine with a public IP would expose a key-holding gateway.
BIND_HOST=127.0.0.1
# Comma-separated allowlist; entries may be '*.example.com'. '*' = allow all.
APP_ORIGIN=http://localhost:5173,https://agentasia.vercel.app
# When published behind a shared hostname (e.g. https://host/v1/agentasia) set the
# prefix here and it is stripped before routing. Empty = served at the root.
GATEWAY_BASE_PATH=

# Feature flags
MODEL_GATEWAY_ENABLED=true
SCHEDULER_ENABLED=true
SCHEDULE_WORKER_INTERVAL_MS=60000

# ── Primary managed routes ──────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-key
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
VENICE_API_KEY=VENICE-INFERENCE-KEY-your-venice-key

# ── Free / budget routes ────────────────────────────────────────
CUDOS_ASI_KEY=sk-your-cudos-key
ASI1_API_KEY=sk-your-asi1-key

# ── Regional / alt routes ───────────────────────────────────────
REDPILL_API_KEY=sk-rp-your-redpill-key
ZHIPU_API_KEY=your-zhipu-key
GROQ_API_KEY=gsk-your-groq-key
MISTRAL_API_KEY=your-mistral-key
AGENTROUTER_API_KEY=sk-your-agentrouter-key
CROWLLM_API_KEY=sk-your-crowllm-key
INCEPTION_API_KEY=sk-your-inception-key

# ── Local / self-hosted routes (optional) ───────────────────────
MESHLLM_URL=http://localhost:9337/v1
MESHLLM_API_KEY=dummy
MESHLLM_MODEL=naga1-mini
PETALS_URL=http://localhost:8888/v1
PETALS_API_KEY=

# ── Data persistence ────────────────────────────────────────────
SCHEDULES_FILE=/data/schedules.json
SCHEDULE_RUNS_FILE=/data/schedule-runs.json

# ── Coming soon ─────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_
# STRIPE_WEBHOOK_SECRET=whsec_
# COMPOSIO_API_KEY=

# ── Nebius Token Factory — NVIDIA Nemotron (hackathon-required lane) ─
# https://tokenfactory.nebius.com -> API Keys. Preferred (first) lane in the router.
NEBIUS_API_KEY=

# ── Tavily — live web search for spoken/verifiable facts ───────────
TAVILY_API_KEY=

# ── AgentAsia managed gateway (browser app target) ─────────────────
# When set in the CLIENT build (VITE_AGENTASIA_GATEWAY_URL), the UI hides all
# bring-your-own-key providers and in-browser LLM chat, showing only this lane.
# e.g. https://api.agentasia.dev  (this gateway exposes /v1/chat/completions)
GATEWAY_DEFAULT_PROVIDER=nebius

# ── Memory (the naga's guarded crest gem) — intentionally NO server-side key ─
# AgentAsia does not host user memory: default is local encrypted memory in the
# user's own browser (AES-GCM-256, IndexedDB/OPFS). Users may add their own Mem0
# key, or one aggregator MCP endpoint (Composio/Pipedream/Zapier), so their data
# lives in THEIR account. Per-request keys are transient: never stored or logged.

# ── Spend circuit-breaker (our guard; Token Factory has no hard stop) ─────
# Card is auto-charged at the billing threshold, so we refuse BEFORE calling
# Nebius once these caps are hit. Prices are baked into src/spend-guard.mjs.
SPEND_GUARD_ENABLED=true
DAILY_SPEND_CAP_USD=0.50
TOTAL_SPEND_CAP_USD=20
SPEND_FILE=/data/spend.json

# ── Alerts (budget + ledger emails; Resend free tier = 3,000/mo, 100/day) ─
ALERT_EMAIL=redacted@users.noreply.github.com
ALERT_FROM_EMAIL="AgentAsia Gateway <alerts@agentasia.dev>"   # must be a verified Resend domain
RESEND_API_KEY=
ALERT_DEDUPE_MINUTES=60
# optional second channel if Resend fails (Slack/Discord/Telegram-bridge webhook)
ALERT_WEBHOOK_URL=
